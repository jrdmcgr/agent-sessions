#!/usr/bin/env bash
# Spawn a pi subagent to run one task in an isolated git worktree, capturing
# its session (cost/duration) and the commit it produces.
#
# Why a persisted session (no --no-session): this repo's `sessions` report
# discovers work by globbing ~/.pi/agent/sessions/*/*.jsonl — exactly one dir
# deep. A --no-session child is invisible; a nested --session-dir is TWO deep
# and also invisible. So the child writes to the default root, and the
# worktree's distinct cwd gives it its own slug-dir there automatically.
#
# Usage:
#   spawn-subagent <task-file|prompt> [options]
#
# Options:
#   -n, --name NAME     Session display name (default: task-file basename)
#   -m, --model MODEL   Model (default: claude-sonnet-5)
#   -t, --thinking LVL  Thinking level (default: off)
#   -b, --base REF      Base the worktree on this ref (default: HEAD)
#       --no-worktree   Run in the current repo checkout instead of a worktree
#   -h, --help          Show this help
#
# The task argument is a file path (wrapped as "Read @<abs> and follow the
# instructions") or, if it is not an existing file, a literal prompt. Either
# way a commit directive is appended so the child's work is captured as a sha.
set -euo pipefail

function usage {
	sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-0}"
}

model="claude-sonnet-5"
thinking="off"
base="HEAD"
name=""
worktree=1
task=""

while [[ $# -gt 0 ]]; do
	case "$1" in
		-n|--name)     name="$2"; shift 2 ;;
		-m|--model)    model="$2"; shift 2 ;;
		-t|--thinking) thinking="$2"; shift 2 ;;
		-b|--base)     base="$2"; shift 2 ;;
		--no-worktree) worktree=0; shift ;;
		-h|--help)     usage 0 ;;
		-*)            echo "unknown option: $1" >&2; usage 1 ;;
		*)             task="$1"; shift ;;
	esac
done

[[ -n "$task" ]] || { echo "error: a task file or prompt is required" >&2; usage 1; }

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" \
	|| { echo "error: not inside a git repository" >&2; exit 1; }

# Build the prompt. A path that exists becomes a @-reference (absolute, so it
# resolves from the worktree cwd); anything else is a literal prompt.
if [[ -f "$task" ]]; then
	task_abs="$(cd "$(dirname "$task")" && pwd)/$(basename "$task")"
	prompt="Read @${task_abs} and follow the instructions."
	[[ -n "$name" ]] || name="$(basename "$task")"
else
	prompt="$task"
	[[ -n "$name" ]] || name="subagent"
fi
prompt+=" Work only inside the current directory: do not cd elsewhere or operate on another clone of this repository, even if the task text names an absolute path. Commit your work here when done with a clear message, and nothing else."

# A slug safe for a branch name and worktree dir.
slug="$(printf '%s' "$name" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')"
stamp="$(date +%Y%m%d-%H%M%S)"
branch="subagent/${slug}-${stamp}"

if [[ "$worktree" -eq 1 ]]; then
	tmp_base="${TMPDIR:-/tmp}"; tmp_base="${tmp_base%/}"
	wt_dir="${tmp_base}/spawn-subagent/${slug}-${stamp}"
	mkdir -p "$(dirname "$wt_dir")"
	git -C "$repo_root" worktree add -q -b "$branch" "$wt_dir" "$base"
	run_dir="$wt_dir"
else
	run_dir="$repo_root"
	branch="$(git -C "$repo_root" rev-parse --abbrev-ref HEAD)"
fi

base_sha="$(git -C "$run_dir" rev-parse HEAD)"
# Guard: in worktree mode the parent checkout must not move. If it does, the
# child escaped its worktree (e.g. a task that cd's to the canonical path) and
# committed onto the parent's live branch.
parent_head_before="$(git -C "$repo_root" rev-parse HEAD)"

echo "spawn-subagent: ${name}" >&2
echo "  model=${model} thinking=${thinking} branch=${branch}" >&2
echo "  cwd=${run_dir}" >&2

# Run the child. Persisted session (no --no-session) so it lands in the report.
( cd "$run_dir" && pi -p \
	--name "subagent: ${name}" \
	--model "$model" \
	--thinking "$thinking" \
	"$prompt" ) || echo "spawn-subagent: child exited nonzero" >&2

head_sha="$(git -C "$run_dir" rev-parse HEAD)"

echo "" >&2
echo "=== spawn-subagent result ===" >&2
printf 'name:     %s\n' "$name" >&2
printf 'branch:   %s\n' "$branch" >&2
printf 'worktree: %s\n' "$run_dir" >&2
printf 'base:     %s\n' "$base_sha" >&2
printf 'head:     %s\n' "$head_sha" >&2
if [[ "$head_sha" == "$base_sha" ]]; then
	echo 'committed: NO — child produced no commit' >&2
else
	echo 'committed: yes' >&2
	git -C "$run_dir" --no-pager log --oneline "${base_sha}..${head_sha}" >&2
fi
if [[ "$worktree" -eq 1 ]]; then
	parent_head_after="$(git -C "$repo_root" rev-parse HEAD)"
	if [[ "$parent_head_after" != "$parent_head_before" ]]; then
		echo "WARNING: parent checkout HEAD moved ${parent_head_before} -> ${parent_head_after}" >&2
		echo "         the child escaped its worktree and committed onto ${repo_root}" >&2
	fi
	echo "cleanup:  git -C ${repo_root} worktree remove ${run_dir}" >&2
fi
